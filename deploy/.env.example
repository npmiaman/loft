# Copy to deploy/.env and fill in. Never commit the real .env.

# The public hostname Caddy gets a TLS cert for. DNS must point here; 80/443 open.
PIGEON_DOMAIN=pigeon.example.com

# Postgres password (compose creates the db/user with it).
POSTGRES_PASSWORD=change-me-long-random

# Blob storage. Encrypted profile data and fingerprints live here.
# AWS:   s3://my-pigeon-bucket/pigeon          (+ AWS_* below, region set)
# R2:    s3://my-pigeon-bucket/pigeon          (+ PIGEON_S3_ENDPOINT=https://<acct>.r2.cloudflarestorage.com)
# MinIO: s3://pigeon                          (+ PIGEON_S3_ENDPOINT=http://minio:9000, uncomment minio)
PIGEON_BLOBS=s3://my-pigeon-bucket/pigeon
PIGEON_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
