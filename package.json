{
  "name": "pigeon-reddit-agent",
  "description": "Pigeon \u2014 a cursor-driven Reddit outreach agent (Chrome extension)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:logic": "tsx tests/logic.test.ts",
    "test:e2e": "node tests/e2e/run.mjs && node tests/e2e/human.mjs && node tests/e2e/ui.mjs && node tests/e2e/agent.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wxt": "^0.21.5"
  }
}